{
  "Header Template": {
    "scope": "c++,cpp,c",
    "prefix": "Header Template",
    "body": [
      "////////////////////////////////////////////////////////////////////////////////",
      "/// \\file ${1}",
      "///",
      "/// \\brief ${2}",
      "////////////////////////////////////////////////////////////////////////////////",
      "",
      "// Copyright (c) Matthew Rodusek",
      "// SPDX-License-Identifier: MIT",
      "// See the LICENSE file at the root of this repository for the full text.",
      "",
			"#ifndef ${4:include_guard}",
      "#define ${4:include_guard}",
      "",
      "#if defined(_MSC_VER)",
      "# pragma once",
      "#endif",
      "",
      "$0",
      "",
      "#endif /* ${4:include_guard} */"
    ],
    "description": "C++ header template"
  },
	"Source Template": {
    "scope": "c++,cpp,c",
    "prefix": "Source Template",
    "body": [
      "// Copyright (c) Matthew Rodusek",
      "// SPDX-License-Identifier: MIT",
      "// See the LICENSE file at the root of this repository for the full text.",
      "",
			"$0"
    ],
    "description": "C++ source template"
  },
  "Section Template": {
    "scope": "c++,cpp,c,h,hpp",
    "prefix": "Section Template",
    "body": [
      "    //--------------------------------------------------------------------------",
      "    // ${1:section}",
      "    //--------------------------------------------------------------------------",
      "  ${2:public}:",
      "  $0"
    ]
  }
}
